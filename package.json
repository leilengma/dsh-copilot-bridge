{
  "name": "dsh-copilot-bridge",
  "description": "GitHub Copilot Bridge provider for DeepSeek Harness with device-flow sign-in, a live model catalog and GitHub Enterprise support; native github-copilot stays untouched",
  "version": "1.0.0",
  "license": "MIT",
  "icon": "assets/github-copilot.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./icon": "./assets/github-copilot.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "assets/github-copilot.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leilengma/dsh-copilot-bridge.git"
  },
  "homepage": "https://github.com/leilengma/dsh-copilot-bridge#readme",
  "bugs": "https://github.com/leilengma/dsh-copilot-bridge/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "github-copilot",
    "github-enterprise",
    "ghe",
    "oauth"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-commands": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings-general": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-launch-environment": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.5",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@earendil-works/pi-ai": "~1.3.0",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
